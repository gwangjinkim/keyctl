#!/usr/bin/env python3
"""keyctl - CLI to store API keys in OS credential stores."""

import argparse
import json
import os
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse

PROG = "keyctl"
TOKEN_ENV = "KEYCTL_TOKEN"
API_PORT = 9099
API_HOST = "127.0.0.1"


def _run(cmd, input_data=None):
    return subprocess.run(
        cmd, input=input_data, capture_output=True, text=True, check=False
    )


# ---------------------------------------------------------------- backends

def keychain_get(keyword):
    """Read from macOS Keychain via `security`."""
    item = _run(["security", "find-generic-password", "-s", f"keyctl:{keyword}", "-w"])
    if item.returncode != 0:
        return None
    return item.stdout.rstrip("\n")


def keychain_add(keyword, value):
    _run(["security", "add-generic-password", "-s", f"keyctl:{keyword}", "-v", value])


def keychain_remove(keyword):
    _run(["security", "delete-generic-password", "-s", f"keyctl:{keyword}"])


def secret_get(keyword):
    """Read from Linux Secret Service via `secret-tool`."""
    item = _run(["secret-tool", "lookup", f"keyctl:{keyword}"])
    if item.returncode != 0:
        return None
    return item.stdout.rstrip("\n")


def secret_add(keyword, value):
    _run(["secret-tool", "store", "--label", f"keyctl:{keyword}", f"keyctl:{keyword}", value])


def secret_remove(keyword):
    _run(["secret-tool", "clear", f"keyctl:{keyword}"])


def win_get(keyword):
    """Read from Windows Credential Manager via `cmdkey`."""
    item = _run(["cmdkey", "/list", f"/generic:API:{keyword}"])
    if item.returncode != 0 or "Password" not in item.stdout:
        return None
    out = _run(["cmdkey", "/tv", f"/generic:API:{keyword}"])
    user = None
    password = None
    for line in out.stdout.splitlines():
        if line.startswith("UserName"):
            user = line.split("=", 1)[1].strip()
        elif line.startswith("Password"):
            password = line.split("=", 1)[1].strip()
    if not user or not password:
        return None
    return password


def win_add(keyword, value):
    _run(["cmdkey", "/generic:API", keyword, "/user", keyword, "/pass", value, "/end"])


def win_remove(keyword):
    _run(["cmdkey", "/delete", f"/generic:API:{keyword}"])


def get_backend():
    if os.name == "nt":
        return win_get, win_add, win_remove
    if sys.platform == "darwin":
        return keychain_get, keychain_add, keychain_remove
    return secret_get, secret_add, secret_remove


def list_keywords():
    keywords = []
    if os.name == "nt":
        out = _run(["cmdkey", "/list"])
        for line in out.stdout.splitlines():
            parts = line.split(":")
            if len(parts) >= 2 and "Generic" in parts[0] and parts[1].startswith("API:"):
                kw = parts[1].strip()
                if kw not in keywords:
                    keywords.append(kw[len("API:"):])
    elif sys.platform == "darwin":
        out = _run(["security", "find-generic-passwords"])
        for line in out.stdout.splitlines():
            parts = line.split("class \"")
            if len(parts) >= 2 and parts[1].startswith("genp"):
                kw = parts[1].split('"')[0]
                if kw.startswith("keyctl:") and kw[len("keyctl:"):] not in keywords:
                    keywords.append(kw[len("keyctl:"):])
    else:
        out = _run(["bash", "-c", "secret-tool --list-overrides"])
        for line in out.stdout.splitlines():
            for kw in line.split():
                if kw.startswith("keyctl:") and kw[len("keyctl:"):] not in keywords:
                    keywords.append(kw[len("keyctl:"):])
    return sorted(keywords)


# ---------------------------------------------------------------- commands

def cmd_add(args):
    get, add, _remove = get_backend()
    keyword = args.keyword
    if args.value is not None:
        value = args.value
    elif args.stdin:
        value = sys.stdin.read().rstrip("\n")
    else:
        value = input(f"Enter key for '{keyword}': ").rstrip("\n")
    if not value:
        print("key cannot be empty", file=sys.stderr)
        return 1
    add(keyword, value)
    print(f"stored key for '{keyword}'")
    return 0


def cmd_get(args):
    get, _, _remove = get_backend()
    value = get(args.keyword)
    if value is None:
        print(f"no key found for '{args.keyword}'", file=sys.stderr)
        return 1
    sys.stdout.write(value + "\n")
    return 0


def cmd_list(args):
    keywords = list_keywords()
    for kw in keywords:
        print(kw)
    return 0


def cmd_remove(args):
    get, _, remove = get_backend()
    remove(args.keyword)
    return 0


# ---------------------------------------------------------------- daemon

class KeyctlHandler(BaseHTTPRequestHandler):
    def _auth_ok(self):
        token = os.environ.get(TOKEN_ENV, "")
        auth = self.headers.get("Authorization", "")
        return bool(token) and auth == f"Bearer {token}"

    def _send_json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if not self._auth_ok():
            return self._send_json(401, {"error": "unauthorized"})
        path = urlparse(self.path).path.rstrip("/")
        if path == "/health":
            return self._send_json(200, {"status": "ok"})
        if path == "/list":
            return self._send_json(200, {"keywords": list_keywords()})
        return self._send_json(404, {"error": "not_found"})

    def do_POST(self):
        if not self._auth_ok():
            return self._send_json(401, {"error": "unauthorized"})
        length = int(self.headers.get("Content-Length") or 0)
        payload = json.loads(self.rfile.read(length) or b"{}")
        keyword = payload.get("keyword")
        if not keyword:
            return self._send_json(400, {"error": "keyword required"})
        get, add, _r = get_backend()
        if "key" in payload:
            add(keyword, payload["key"])
            return self._send_json(200, {"status": "stored"})
        value = get(keyword)
        if value is None:
            return self._send_json(404, {"error": "not_found"})
        return self._send_json(200, {"keyword": keyword, "key": value})

    def do_DELETE(self):
        if not self._auth_ok():
            return self._send_json(401, {"error": "unauthorized"})
        parsed = urlparse(self.path)
        keyword = parsed.query.get("keyword")
        if not keyword:
            return self._send_json(400, {"error": "keyword required"})
        _, _, remove = get_backend()
        remove(keyword)
        return self._send_json(200, {"status": "removed"})

    def log_message(self, fmt, *args):
        sys.stderr.write(f"{self.address_string()} - {fmt % args}\n")


def cmd_daemon(args):
    server = ThreadingHTTPServer((API_HOST, args.port), KeyctlHandler)
    server.serve_forever()
    return 0


# ---------------------------------------------------------------- main

def main(argv=None):
    parser = argparse.ArgumentParser(prog=PROG, description="Manage API keys in the OS credential store.")
    sub = parser.add_subparsers(dest="cmd")

    p_add = sub.add_parser("add", help="store a key")
    p_add.add_argument("keyword")
    p_add.add_argument("--value", "-v")
    p_add.add_argument("--stdin", action="store_true")
    p_add.set_defaults(func=cmd_add)

    p_get = sub.add_parser("get", help="fetch a key")
    p_get.add_argument("keyword")
    p_get.set_defaults(func=cmd_get)

    p_list = sub.add_parser("list", help="list stored keywords")
    p_list.set_defaults(func=cmd_list)

    p_remove = sub.add_parser("remove", help="remove a key")
    p_remove.add_argument("keyword")
    p_remove.set_defaults(func=cmd_remove)

    p_daemon = sub.add_parser("daemon", help="start local HTTP API daemon")
    p_daemon.add_argument("--port", type=int, default=API_PORT)
    p_daemon.set_defaults(func=cmd_daemon)

    args = parser.parse_args(argv)
    if args.cmd == "daemon":
        return cmd_daemon(args)
    if not args.cmd:
        parser.print_help()
        return 2
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
